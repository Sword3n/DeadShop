filters:
  and:
    - file.inFolder("Heroes")
views:
  - type: table
    name: All Heroes
    filters:
      and:
        - file.inFolder("Heroes")
    order:
      - file.name
      - complexity
      - emaxhealth
      - ebasehealthregen
      - emaxmovespeed
      - esprintspeed
      - estamina
      - weapon_damage_per_second
      - weapon_bullet_damage
      - weapon_ammo
      - weapon_bullets_per_sec
      - gun
      - release_date
    sort:
      - property: complexity
        direction: ASC
      - property: file.name
        direction: ASC
